    uncuffAllBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    uncuffAllBtn.Parent = dropFrame
    local uncuffCorner = Instance.new("UICorner")
    uncuffCorner.CornerRadius = UDim.new(0, 6)
    uncuffCorner.Parent = uncuffAllBtn

