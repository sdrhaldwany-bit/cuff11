    countLabel.Position = UDim2.new(0.5, -70, 0, 275)
    countLabel.Text = "Cuffed: 0"
    countLabel.TextScaled = true
    countLabel.BackgroundTransparency = 0.5
    countLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    countLabel.Parent = dropFrame
    local countCorner = Instance.new("UICorner")
    countCorner.CornerRadius = UDim.new(0, 6)
    countCorner.Parent = countLabel

    -- سحب الواجهة
    local dragging = false
    local dragStart = nil
    local startPos = nil

    dragBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = dropFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            dropFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end    end)

    -- أحداث الأزرار
    cuffBtn.MouseButton1Click:Connect(function()
        CuffingActive = not CuffingActive
        cuffBtn.Text = CuffingActive and "Cuff: ON" or "Cuff: OFF"
        cuffBtn.BackgroundColor3 = CuffingActive and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    end)

    cuffAllBtn.MouseButton1Click:Connect(CuffAllPlayers)
    uncuffAllBtn.MouseButton1Click:Connect(UncuffAllPlayers)
    dropBtn.MouseButton1Click:Connect(DropCuffedPlayers)

    local AntiCuffActive = false
    antiCuffBtn.MouseButton1Click:Connect(function()
        AntiCuffActive = not AntiCuffActive
        antiCuffBtn.Text = AntiCuffActive and "Anti-Cuff: ON" or "Anti-Cuff: OFF"
        antiCuffBtn.BackgroundColor3 = AntiCuffActive and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(100, 100, 100)
    end)

    -- كلبشة بالماوس
    Mouse.Button1Down:Connect(function()
        if not CuffingActive then return end
        local target = Mouse.Target
        if not target then return end
        local char = target:FindFirstAncestorOfClass("Model")
        local plr = char and Players:GetPlayerFromCharacter(char)
        if plr and plr ~= LP then ToggleCuff(plr) end
    end)

    -- تحديث العداد
    RunService.RenderStepped:Connect(function()
        countLabel.Text = "Cuffed: " .. tostring(#CuffedTargets)
    end)

    -- Anti-Cuff
    RunService.Heartbeat:Connect(function()
        if AntiCuffActive then
            UpdateRemoteEvents()
            for _, re in pairs(RemoteEvents) do
                pcall(function() re:FireServer("UnCuff") end)
            end
        end
    end)

    print("Omega Drop Mode Active")
end

