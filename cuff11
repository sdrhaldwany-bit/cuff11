    cuffAllBtn.TextScaled = true
    cuffAllBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    cuffAllBtn.Parent = dropFrame
    local cuffAllCorner = Instance.new("UICorner")
    cuffAllCorner.CornerRadius = UDim.new(0, 6)
    cuffAllCorner.Parent = cuffAllBtn

